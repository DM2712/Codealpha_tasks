# Server Port
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Clerk Authentication (Get from https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_example_key
CLERK_PUBLISHABLE_KEY=pk_test_example_key

# Supabase PostgreSQL (Get from https://supabase.com/dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# External Product API (Default: DummyJSON API)
EXTERNAL_PRODUCT_API_URL=https://dummyjson.com/products
